PORT=3000
# Conexão direta do banco/branch Neon de desenvolvimento (separado de HML).
# Copie a connection string do painel Neon e preserve os parâmetros de SSL.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Opcional: se DATABASE_URL usar pooling (-pooler no host), informe a conexão
# direta do MESMO banco para os comandos Prisma. Sem ela, usa DATABASE_URL.
# DIRECT_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Opcional: banco separado e descartável para prisma migrate dev, caso a role
# não possa criar bancos. Nunca use a URL do banco da aplicação ou de HML.
# SHADOW_DATABASE_URL="postgresql://USUARIO:SENHA@ep-SEU-ENDPOINT.REGIAO.aws.neon.tech/neondb_shadow?sslmode=require&connect_timeout=15"

# Origens exatas da interface (sem barra final). Em produção, somente HTTPS.
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Em produção, obrigatório: gere com node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Compartilhe a mesma chave entre réplicas do MESMO ambiente. Em dev, usa .runtime/auth.key.
# JWT_SECRET="128_caracteres_hexadecimais_aleatorios"
# Use valores diferentes entre desenvolvimento e HML para separar os tokens.
JWT_ISSUER="fsph-frota-api-dev"
JWT_AUDIENCE="fsph-frota-web-dev"
# Apenas atrás de proxy confiável: número exato de saltos até a API.
# TRUST_PROXY_HOPS=1

# CD HML: conexão direta do mesmo banco usado pelo binding Hyperdrive.
# No GitHub, configure como secret DATABASE_URL_MIGRATIONS no environment hml.
# DATABASE_URL_MIGRATIONS="postgresql://USUARIO:SENHA@ep-ENDPOINT.REGIAO.aws.neon.tech/neondb?sslmode=require"
