{
  "devDependencies": {
    "concurrently": "^10.0.6",
    "jsonc-parser": "3.3.1",
    "prettier": "^3.9.10",
    "wrangler": "4.156.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently --kill-others-on-fail -n API,WEB -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:report": "npm run test:e2e:report --workspace=frontend",
    "test:watch": "concurrently --kill-others-on-fail -n API,WEB -c blue,green \"npm run test:watch --workspace=backend\" \"npm run test:watch --workspace=frontend\"",
    "test:coverage": "npm run test:coverage --workspaces",
    "check": "npm run format:check && npm run lint && npm test && npm run test:deploy && npm run build",
    "cloudflare:check": "wrangler deploy --env hml --dry-run",
    "test:deploy": "node --test scripts/*.test.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "BackEnd",
    "FrontEnd"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
