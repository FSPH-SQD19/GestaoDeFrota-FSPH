{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestao-frota",
  "main": "BackEnd/src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./FrontEnd/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/auth",
      "/auth/*",
      "/api/*",
      "/motoristas",
      "/motoristas/*",
      "/solicitacoes",
      "/solicitacoes/*",
    ],
    "not_found_handling": "single-page-application",
  },
  "env": {
    "hml": {
      "name": "gestao-frota-hml",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "d85792d851b94d7d99f875cc8a32476f",
        },
      ],
      "assets": {
        "directory": "./FrontEnd/dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/health",
          "/auth",
          "/auth/*",
          "/api/*",
          "/motoristas",
          "/motoristas/*",
          "/solicitacoes",
          "/solicitacoes/*",
        ],
        "not_found_handling": "single-page-application",
      },
      "vars": {
        "NODE_ENV": "production",
        "JWT_ISSUER": "fsph-frota-api-hml",
        "JWT_AUDIENCE": "fsph-frota-web-hml",
      },
    },
  },
}
